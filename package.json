{
  "name": "renegadecmm",
  "version": "1.5.0",
  "desktopName": "renegadecmm.desktop",
  "description": "Renegade Core Model Manager - the missing model manager for ComfyUI with verified CivitAI API integration and intelligent auto-sorting.",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "main": "dist/main/index.js",
  "bin": {
    "cmm": "bin/cmm.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build --base ./ && tsc -p tsconfig.main.json",
    "preview": "vite preview",
    "test": "vitest run",
    "cmm": "node bin/cmm.js",
    "mode:release": "node scripts/toggle-release.js release",
    "mode:dev": "node scripts/toggle-release.js dev",
    "mode:status": "node scripts/toggle-release.js status",
    "mode:toggle": "node scripts/toggle-release.js toggle",
    "version:bump": "node scripts/update-version.js",
    "electron:dev": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder",
    "electron:preview": "npm run build && electron . --preview",
    "dist": "npm run build && electron-builder --win",
    "dist:win": "npm run build && electron-builder --win",
    "dist:portable": "npm run build && electron-builder --win portable",
    "dist:installer": "npm run build && electron-builder --win nsis",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:dir": "npm run build && electron-builder --dir",
    "dist:all": "npm run build && electron-builder -wlm",
    "package:win": "npm run build && electron-builder --win",
    "package:linux": "npm run build && electron-builder --linux",
    "package:mac": "npm run build && electron-builder --mac",
    "package:all": "npm run build && electron-builder -wlm",
    "cmm:start": "powershell -ExecutionPolicy Bypass -File ./cmm.ps1 start",
    "cmm:stop": "powershell -ExecutionPolicy Bypass -File ./cmm.ps1 stop",
    "cmm:restart": "powershell -ExecutionPolicy Bypass -File ./cmm.ps1 restart",
    "cmm:status": "powershell -ExecutionPolicy Bypass -File ./cmm.ps1 status",
    "cmm:package": "powershell -ExecutionPolicy Bypass -File ./cmm.ps1 package",
    "cmm:start:linux": "./cmm.sh start",
    "cmm:stop:linux": "./cmm.sh stop",
    "cmm:restart:linux": "./cmm.sh restart",
    "cmm:status:linux": "./cmm.sh status",
    "cmm:package:linux": "./cmm.sh package",
    "cmm:start:mac": "./cmm-mac.sh start",
    "cmm:stop:mac": "./cmm-mac.sh stop",
    "cmm:restart:mac": "./cmm-mac.sh restart",
    "cmm:status:mac": "./cmm-mac.sh status",
    "cmm:package:mac": "./cmm-mac.sh package",
    "postinstall": "electron-builder install-app-deps",
    "clean:assets": "node scripts/clean-assets.js"
  },
  "keywords": [
    "civitai",
    "comfyui",
    "model-manager",
    "stable-diffusion",
    "flux",
    "lora",
    "checkpoint"
  ],
  "author": {
    "name": "DevNullInc (/dev/null Inc / TheStygianRenegade)",
    "email": "devnull@devnullinc.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DevNullInc/RenegadeCMM.git"
  },
  "bugs": {
    "url": "https://github.com/DevNullInc/RenegadeCMM/issues"
  },
  "homepage": "https://github.com/DevNullInc/RenegadeCMM#readme",
  "license": "GPL-3.0",
  "dependencies": {
    "adm-zip": "^0.6.0",
    "axios": "^1.7.9",
    "chokidar": "^4.0.3",
    "electron-log": "^5.3.0",
    "electron-updater": "^6.8.9",
    "keytar": "^7.9.0",
    "litegraph.js": "^0.7.18",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-window": "^1.8.11",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@tootallnate/once": "^2.0.1"
  },
  "build": {
    "appId": "com.devnullinc.renegadecmm",
    "productName": "RenegadeCMM",
    "copyright": "Copyright (C) 2025-2026 TheStygianRenegade / /dev/null Inc",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "packElevateHelper": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-v${version}.exe"
    },
    "linux": {
      "syncDesktopName": true,
      "maintainer": "TheStygianRenegade / /dev/null Inc <devnull@devnullinc.com>",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Graphics",
      "artifactName": "${productName}-Linux-${version}-${arch}.${ext}"
    },
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "artifactName": "${productName}-Mac-${version}-${arch}.${ext}"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "allowScripts": {
    "electron@44.0.0": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "keytar@7.9.0": true,
    "sqlite3@6.0.1": true
  }
}
